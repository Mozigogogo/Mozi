# 必填：@BotFather 获取
BOT_TOKEN=

# 可选：设为 1 / true / yes 时打印命令与 HTTP 调试日志（控制台 [BOT_DEBUG]，不含密钥原文）
# BOT_DEBUG=1

# 新用户注册 / Telegram 登录流程日志（[tg/login]）；默认开启；TG_REGISTER_LOG=0 关闭
# TG_REGISTER_LOG=1
# TG_REGISTER_DEBUG=1

# 意图识别 /ai/agent/route 日志（[AGENT_ROUTE]）；默认开启；AGENT_ROUTE_DEBUG=1 打印完整 HTTP body
# AGENT_ROUTE_LOG=1
# AGENT_ROUTE_DEBUG=1

# 可选：/bind_ref 调用 POST /user/tg/queryInviteCode 时打印完整 JSON（默认开启；设为 0 关闭）
# QUERY_INVITE_CODE_LOG=1

# Mini App / 站点根地址（与 BotFather 中 Mini App 域名一致时 web_app 按钮最稳）
APP_URL=https://moziinnovations-production.up.railway.app

# 自建 API 根地址（不含路径末尾 /）；未设置时默认为 https://moziinnovations.com
# API_BASE_URL=https://moziinnovations.com

# 机器人 @ 用户名，不要带 @；与 Telegram 上实际 bot 名一致
BOT_USERNAME=Moziinovations_bot

# 可选：/start 与 /alert 卡片图 URL
# ALERT_CARD_IMAGE=https://example.com/card.jpg
# 新用户 Telegram 注册时无头像的后端 avatar 回退（默认与 ALERT_CARD_IMAGE 相同）
# DEFAULT_USER_AVATAR_URL=https://example.com/default-avatar.png

# /ai：流式 POST 完整 URL（可选；默认 ${APP_URL}/api/robot_proxy/api/v1/analyze/stream，请求体同 /chat）
# AI_BACKEND_URL=https://your-app.up.railway.app/api/robot_proxy/api/v1/analyze/stream

# /chat：流式对话 POST 完整 URL（可选；默认 ${APP_URL}/api/robot_proxy/api/v1/chat/stream）
# AI_CHAT_BACKEND_URL=https://your-app.up.railway.app/api/robot_proxy/api/v1/chat/stream
# /bigorder：大单侦测 SSE，与 /ai、/chat 共用主栈 POST ${API_BASE_URL}/ai/agent/stream（type=bigorder，不扣积分）
# 可选覆盖流式 URL：AI_AGENT_STREAM_URL=https://moziinnovations.com/ai/agent/stream
# 旧版独立大单后端（代码中 requestBigorderStream，当前 /bigorder 命令未使用）：
# ROBOT_BACKEND_URL=https://mozibackend-production.up.railway.app
# BIGORDER_CHAT_BACKEND_URL=https://mozibackend-production.up.railway.app/bigorder/v1/chat
# /bigorder 过程日志 [BIGORDER]，默认开启；BIGORDER_LOG=0 关闭；BIGORDER_DEBUG=1 打印 SSE 分片
# BIGORDER_LOG=1
# BIGORDER_DEBUG=1
# /ai、/chat、/bigorder 等待 SSE 的最长时间（毫秒），默认 300000（5 分钟）
# AI_CHAT_STREAM_TIMEOUT_MS=600000
# Agent 意图识别 POST 完整 URL（可选；默认 ${API_BASE_URL}/ai/agent/route）
# AI_AGENT_ROUTE_URL=https://moziinnovations.com/ai/agent/route
# 交互模式：natural（默认，@Bot 自然语言意图识别 + 斜杠命令）| command（仅斜杠命令）
# BOT_INPUT_MODE=natural
# 意图识别详细 HTTP 日志（默认每次 @ 提及会打 [AGENT_ROUTE] response；设 1 可额外打原始 body）
# AGENT_ROUTE_DEBUG=1

# 可选：Bootstrap JWT，请求头 authentication（无用户 token 时用于 POST tg/login、registered/check）
# MOZI_DETAIL_AUTH=

# 私聊/群内「重新登录」过程日志 [MOZI_RELOGIN]，默认开启；MOZI_RELOGIN_LOG=0 关闭
# MOZI_RELOGIN_LOG=1
# MOZI_RELOGIN_DEBUG=1

# 可选：POST 用 telegramId 换用户 JWT（相对 API_BASE_URL），默认 user/tg/login；/balance 等优先带该 JWT
# TG_LOGIN_PATH=user/tg/login

# /balance：GET 路径（相对 API_BASE_URL），默认 user/datainfo（与 H5 一致；鉴权为登录 JWT，无 telegramId 查询参数）
# USER_DATA_INFO_PATH=user/datainfo
# /balance：GET user/datainfo 超时（毫秒），默认 45000；后端慢于此前限会报「查询超时」而非笼统网络错误
# USER_DATA_INFO_TIMEOUT_MS=60000
# /ai 底部展示积分数；后端也可在流里返回 pointsCost 覆盖
# AI_POINTS_COST=50
# /ai、/chat：扣减成功后会把「剩余积分」写入进程内缓存；可选 USER_POINTS_DATAINFO_SKIP_TTL_MS（毫秒，默认 0）在缓存仍新鲜且积分够用时跳过 GET user/datainfo
# USER_POINTS_DATAINFO_SKIP_TTL_MS=0

# 可选：大于 0 时 Bot 进程内启动 POST /tg/chat/save、GET /tg/chat/get（内存缓存，TTL 10 分钟）
# 生产若由 API_BASE_URL 主站提供同路径，可不启；本地联调可设 8787 并将 API_BASE_URL=http://127.0.0.1:8787
# TG_CHAT_API_PORT=8787
# 注册完成后轮询 registered/check 的间隔（毫秒），默认 3000
# TG_CHAT_REGISTER_POLL_MS=3000  # 已废弃：注册重放改由 POST /tg/chat/on-registered 触发

# GET /group 群列表（相对 API_BASE_URL），默认 tg/stats/group/listByTelegramId
# TG_GROUP_LIST_BY_TELEGRAM_ID_PATH=tg/stats/group/listByTelegramId
# /group 群列表调试日志 [tg/group]，默认开启；TG_GROUP_LIST_LOG=0 关闭
# TG_GROUP_LIST_LOG=1
# TG_GROUP_LIST_DEBUG=1
# POST 自动推送开关（autoPublishGuess），默认 tg/stats/group/save
# TG_GROUP_SAVE_PATH=tg/stats/group/save
# 每日定时自动发布 AI 信号卡（北京时间），默认 09:00 开启
# PREDICT_AUTO_PUBLISH_ENABLED=1
# PREDICT_AUTO_PUBLISH_TIME=09:00
# PREDICT_AUTO_PUBLISH_SYMBOL=BTC
# PREDICT_AUTO_PUBLISH_LOG=1
# PREDICT_AUTO_PUBLISH_DEBUG=1
# bindMessage 需要服务端鉴权（autoPublish 本身无需 token）
# MOZI_DETAIL_AUTH=
# COIN_DIRECTION_GUESS_PUBLISH_PATH=coinDirectionGuess/publish
# 定时批量自动发布 AI 信号卡（相对 API_BASE_URL，无需 token），默认 coinDirectionGuess/autoPublish
# COIN_DIRECTION_GUESS_AUTO_PUBLISH_PATH=coinDirectionGuess/autoPublish
# COIN_DIRECTION_GUESS_AUTO_PUBLISH_TIMEOUT_MS=120000
# /predict 发布后绑定 TG 消息 ID（相对 API_BASE_URL），默认 coinDirectionGuess/bindMessage
# COIN_DIRECTION_GUESS_BIND_MESSAGE_PATH=coinDirectionGuess/bindMessage
# /predict 群内下注投票（相对 API_BASE_URL），默认 coinDirectionGuess/bet
# COIN_DIRECTION_GUESS_BET_PATH=coinDirectionGuess/bet
# /predict list 本群竞猜列表（相对 API_BASE_URL），默认 coinDirectionGuess/list
# COIN_DIRECTION_GUESS_LIST_PATH=coinDirectionGuess/list
# 竞猜截止结算查询详情（相对 API_BASE_URL），默认 coinDirectionGuess/detail
# COIN_DIRECTION_GUESS_DETAIL_PATH=coinDirectionGuess/detail
# 竞猜最低/最高下注积分（自定义输入），默认 50 / 500
# COIN_DIRECTION_GUESS_MIN_BET_AMOUNT=50
# COIN_DIRECTION_GUESS_MAX_BET_AMOUNT=500
# 单群同时进行中的竞猜上限，默认 3
# COIN_DIRECTION_GUESS_MAX_ACTIVE_PER_GROUP=3
# 竞猜发布流程调试（[PREDICT_PUBLISH]），默认开启；PREDICT_PUBLISH_LOG=0 关闭
# PREDICT_PUBLISH_LOG=1
# 无头像用户发起竞猜调试（[GUESS_NO_AVATAR]），默认开启；PREDICT_NO_AVATAR_LOG=0 关闭
# PREDICT_NO_AVATAR_LOG=1

# POST /tg/stats/group/save 日志（[TG_GROUP_STATS]），默认关闭；TG_GROUP_STATS_LOG=1 开启
# TG_GROUP_STATS_LOG=0

# 竞猜 list 轮询日志（[GUESS_POLL]），默认关闭；GUESS_POLL_LOG=1 开启
# GUESS_POLL_LOG=0
# 竞猜群内卡片刷新轮询间隔（毫秒），默认 300000（5 分钟）；轮询 GET /coinDirectionGuess/list?groupId=
# GUESS_SETTLEMENT_POLL_MS=300000
# 打印涨跌竞猜相关接口完整响应（[GUESS_API]）；也可设 BOT_DEBUG=1
# COIN_DIRECTION_GUESS_API_DEBUG=1
# 竞猜消息上下文持久化路径，默认 bot/data/guess-context.json
# GUESS_CONTEXT_STORE_PATH=/path/to/guess-context.json
