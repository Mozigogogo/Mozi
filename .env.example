# 必填：@BotFather 获取
BOT_TOKEN=

# 可选：设为 1 / true / yes 时打印命令与 HTTP 调试日志（控制台 [BOT_DEBUG]，不含密钥原文）
# BOT_DEBUG=1

# 可选：/bind_ref 调用 POST /user/tg/queryInviteCode 时打印完整 JSON（默认开启；设为 0 关闭）
# QUERY_INVITE_CODE_LOG=1

# Mini App / 站点根地址（与 BotFather 中 Mini App 域名一致时 web_app 按钮最稳）
APP_URL=https://moziinnovations-production.up.railway.app

# 自建 API 根地址（不含路径末尾 /）；未设置时默认为 https://moziinnovations.com
# API_BASE_URL=https://moziinnovations.com

# 机器人 @ 用户名，不要带 @；与 Telegram 上实际 bot 名一致
BOT_USERNAME=Moziinovations_bot

# 可选：/start 与 /alert 卡片图 URL
# ALERT_CARD_IMAGE=https://example.com/card.jpg

# /ai：流式 POST 完整 URL（可选；默认 ${APP_URL}/api/robot_proxy/api/v1/analyze/stream，请求体同 /chat）
# AI_BACKEND_URL=https://your-app.up.railway.app/api/robot_proxy/api/v1/analyze/stream

# /chat：流式对话 POST 完整 URL（可选；默认 ${APP_URL}/api/robot_proxy/api/v1/chat/stream）
# AI_CHAT_BACKEND_URL=https://your-app.up.railway.app/api/robot_proxy/api/v1/chat/stream
# /ai 与 /chat 等待 SSE 的最长时间（毫秒），默认 300000（5 分钟）
# AI_CHAT_STREAM_TIMEOUT_MS=600000

# 可选：Bootstrap JWT，请求头 authentication（无用户 token 时用于 POST tg/login、registered/check）
# MOZI_DETAIL_AUTH=

# 可选：POST 用 telegramId 换用户 JWT（相对 API_BASE_URL），默认 user/tg/login；/balance 等优先带该 JWT
# TG_LOGIN_PATH=user/tg/login

# /balance：GET 路径（相对 API_BASE_URL），默认 user/datainfo（与 H5 一致；鉴权为登录 JWT，无 telegramId 查询参数）
# USER_DATA_INFO_PATH=user/datainfo
# /balance：GET user/datainfo 超时（毫秒），默认 45000；后端慢于此前限会报「查询超时」而非笼统网络错误
# USER_DATA_INFO_TIMEOUT_MS=60000
# /ai 底部展示积分数；后端也可在流里返回 pointsCost 覆盖
# AI_POINTS_COST=50
# /ai、/chat：扣减成功后会把「剩余积分」写入进程内缓存；可选 USER_POINTS_DATAINFO_SKIP_TTL_MS（毫秒，默认 0）在缓存仍新鲜且积分够用时跳过 GET user/datainfo
# USER_POINTS_DATAINFO_SKIP_TTL_MS=0

# 可选：大于 0 时 Bot 进程内启动 POST /tg/chat/save、GET /tg/chat/get（内存缓存，TTL 10 分钟）
# 生产若由 API_BASE_URL 主站提供同路径，可不启；本地联调可设 8787 并将 API_BASE_URL=http://127.0.0.1:8787
# TG_CHAT_API_PORT=8787
# 注册完成后轮询 registered/check 的间隔（毫秒），默认 3000
# TG_CHAT_REGISTER_POLL_MS=3000  # 已废弃：注册重放改由 POST /tg/chat/on-registered 触发
