# 必填：@BotFather 获取
BOT_TOKEN=

# 可选：设为 1 / true / yes 时打印命令与 HTTP 调试日志（控制台 [BOT_DEBUG]，不含密钥原文）
# BOT_DEBUG=1

# Mini App / 站点根地址（与 BotFather 中 Mini App 域名一致时 web_app 按钮最稳）
APP_URL=https://moziinnovations-production.up.railway.app

# 自建 API 根地址（不含路径末尾 /）；未设置时默认为 https://moziinnovations.com
# API_BASE_URL=https://moziinnovations.com

# 机器人 @ 用户名，不要带 @；与 Telegram 上实际 bot 名一致
BOT_USERNAME=Moziinovations_bot

# 可选：/start 与 /alert 卡片图 URL
# ALERT_CARD_IMAGE=https://example.com/card.jpg

# /ai：流式 POST 完整 URL（可选；默认 ${APP_URL}/api/robot_proxy/api/v1/analyze/stream，请求体同 /chat）
# AI_BACKEND_URL=https://your-app.up.railway.app/api/robot_proxy/api/v1/analyze/stream

# /chat：流式对话 POST 完整 URL（可选；默认 ${APP_URL}/api/robot_proxy/api/v1/chat/stream）
# AI_CHAT_BACKEND_URL=https://your-app.up.railway.app/api/robot_proxy/api/v1/chat/stream
# /ai 与 /chat 等待 SSE 的最长时间（毫秒），默认 300000（5 分钟）
# AI_CHAT_STREAM_TIMEOUT_MS=600000

# 可选：与浏览器相同的 JWT，请求头 authentication（registered/check、GET 积分摘要等若后端需要）
# MOZI_DETAIL_AUTH=

# /balance：GET 路径（相对 API_BASE_URL），默认 user/tg/points/summary?telegramId=
# TG_POINTS_SUMMARY_PATH=user/tg/points/summary
# /ai 底部展示积分数；后端也可在流里返回 pointsCost 覆盖
# AI_POINTS_COST=50
# /chat 底部展示积分数；后端也可返回 pointsCost 覆盖
# AI_CHAT_POINTS_COST=10
